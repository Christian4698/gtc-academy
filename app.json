{
  "expo": {
    "name":        "GTC Academy",
    "slug":        "gtc-academy",
    "version":     "1.0.0",
    "orientation": "portrait",
    "scheme":      "gtcacademy",
    "icon":        "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor":    "#030C1E",
    "splash": {
      "image":           "./assets/splash.png",
      "resizeMode":      "contain",
      "backgroundColor": "#030C1E"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier":        "com.generaltech.gtcacademy",
      "buildNumber":             "1",
      "supportsTablet":          false,
      "requireFullScreen":       true,
      "usesAppleSignIn":         false
    },
    "android": {
      "package":             "com.generaltech.gtcacademy",
      "versionCode":         1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#030C1E"
      },
      "permissions": [
        "INTERNET",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      ["expo-notifications", {
        "icon": "./assets/notification-icon.png",
        "color": "#00C8FF"
      }],
      ["expo-av", { "microphonePermission": false }],
      "expo-font"
    ],
    "runtimeVersion": "1.0.0",
    "updates": {
      "enabled": false
    }
  }
}
