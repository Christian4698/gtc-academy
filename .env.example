# ============================================================
#  GTC ACADEMY — Environment Variables
#  Copy to .env and fill in your values
#  NEVER commit .env to version control
# ============================================================

# ── SUPABASE ──────────────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── ANTHROPIC (Claude AI) ─────────────────────────────────────────────────────
# Get from: https://console.anthropic.com/keys
# NOTE: In production, proxy requests through a Supabase Edge Function
#       to keep this key server-side only.
EXPO_PUBLIC_ANTHROPIC_KEY=sk-ant-api03-...

# ── STRIPE ────────────────────────────────────────────────────────────────────
# Get from: Stripe Dashboard → Developers → API Keys
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Price IDs from Stripe Dashboard → Products
EXPO_PUBLIC_STRIPE_MONTHLY_PRICE_ID=price_...
EXPO_PUBLIC_STRIPE_ANNUAL_PRICE_ID=price_...

# ── APP ───────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_URL=https://gtcacademy.com
EXPO_PUBLIC_GTC_WEBSITE_URL=https://www.generaltechconsult.com
EXPO_PUBLIC_SUPPORT_WHATSAPP=+243829664720
EXPO_PUBLIC_APP_ENV=production   # development | staging | production

# Admin email addresses (comma-separated, no spaces)
EXPO_PUBLIC_ADMIN_EMAILS=contact@generaltechconsult.com

# EAS Project ID (from expo.dev or eas.json)
EXPO_PUBLIC_EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── SERVER-SIDE ONLY (Supabase Edge Functions Secrets) ───────────────────────
# Set via: supabase secrets set KEY=VALUE
# DO NOT prefix with EXPO_PUBLIC_ — these must stay server-side

# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# ANTHROPIC_KEY=sk-ant-...         (server-side proxy)
# EMAIL_PROVIDER=resend|sendgrid|smtp
# EMAIL_FROM=GTC Academy <contact@generaltechconsult.com>
# EMAIL_API_KEY=re_...
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
# PUSH_PROVIDER=expo
# SENTRY_DSN=https://...
# POSTHOG_API_KEY=phc_...
# GA_MEASUREMENT_ID=G-...
# MOBILE_MONEY_PROVIDER=placeholder
# MPESA_CONSUMER_KEY=...
# MPESA_CONSUMER_SECRET=...
# ORANGE_MONEY_MERCHANT_KEY=...
# AIRTEL_MONEY_CLIENT_ID=...
# CLOUDFLARE_STREAM_TOKEN=...
# BUNNYCDN_API_KEY=...
